generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WebsiteLead {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String?
  concern     String
  message     String?
  pageUrl     String?
  excelStatus String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("website_leads")
}
